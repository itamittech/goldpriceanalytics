# Gold Price Analytics - Environment Variables Example
# Copy this file to .env and fill in your API keys

# Alpha Vantage API Key (for gold price data)
# Get your free key at: https://www.alphavantage.co/support/#api-key
# Free tier: 25 requests/day
ALPHA_VANTAGE_API_KEY=demo

# NewsAPI Key (for news and events data)
# Get your free key at: https://newsapi.org/register
# Free tier: 100 requests/day
NEWS_API_KEY=

# Database Configuration (Optional - defaults to H2 in-memory)
# Uncomment and configure if using PostgreSQL
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/goldanalytics
# SPRING_DATASOURCE_USERNAME=golduser
# SPRING_DATASOURCE_PASSWORD=your_password

# Server Configuration (Optional)
# SERVER_PORT=8080

# Note: The .env file is in .gitignore and will NOT be committed to git
